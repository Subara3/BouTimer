; 作業のおとも、棒人間：集中の見守り（アプリ別の時間・サボり先）
; main.hsp から #include で読み込む（ラベルだけのファイル。上から流れては実行されない）

; ---- 集中の見守り ----
; ih のプロセスの実行ファイル名（小文字）を exename に
*exe_of
	exename = ""
	pid = 0
	GetWindowThreadProcessId ih, pid
	hp = OpenProcess(0x1000, 0, pid)
	if hp = 0 : return
	sdim pbuf, 1040 : plen = 520
	QueryFullProcessImageName hp, 0, pbuf, plen
	CloseHandle hp
	exename = getpath(cnvwtos(pbuf), 8 + 16)
	return

; 窓（chk_h）がタスクバーやスタートメニューか（is_shell に 1）。クラス名で見る
*is_shell_win
	is_shell = 0
	memset wbuf, 0, 1024
	GetClassNameW chk_h, wbuf, 255
	shcls = cnvwtos(wbuf)
	if shcls = "Shell_TrayWnd" : is_shell = 1
	if shcls = "Shell_SecondaryTrayWnd" : is_shell = 1
	if shcls = "Windows.UI.Core.CoreWindow" : is_shell = 1
	if shcls = "Progman" : is_shell = 1
	if shcls = "WorkerW" : is_shell = 1
	return

; 窓（chk_h）がこのアプリ自身のものか（is_mine に 1）。プロセスの番号で見る
*check_mine
	chk_pid = 0
	GetWindowThreadProcessId chk_h, chk_pid
	is_mine = (chk_pid = GetCurrentProcessId())
	return

; 1秒ごと：前面のアプリの時間・切り替え回数・サボり先の見張り
*track_apps
	if (frame \ 60) != 0 : return
	slack_now = 0
	fgh = fg_root()
	if fgh = 0 : return
	; このアプリ自身の窓（棒人間・内訳・設定・やることリストなど）は数えない
	chk_h = fgh : gosub *check_mine
	if is_mine : return
	if fgh != lastfg {
		if lastfg : switches_today++ : swlog(swi \ 64) = frame : swi++
		lastfg = fgh
		chk_h = fgh : gosub *is_shell_win
		if is_shell = 0 : usefg = fgh
		ih = fgh : gosub *exe_of : fgexe = exename
	}
	if ((idlems > 60000) & (closetest = 0)) | (fgexe = "") : return
	ai = -1
	repeat napp
		if appname(cnt) = fgexe : ai = cnt : break
	loop
	if (ai < 0) & (napp < 40) {
		ai = napp : appname(ai) = fgexe : appsec(ai) = 0 : napp++
	}
	if ai >= 0 : appsec(ai)++
	if (phase = 0) & (paused = 0) {
		; タイトルとアプリ名に、登録した語が入っているか（タイトルは照合するだけで残さない）
		memset wbuf, 0, 1024
		GetWindowTextW fgh, wbuf, 255
		ttl0 = getpath(cnvwtos(wbuf), 16) : ttl = ttl0 + " " + fgexe
		hit = 0
		hiti = 0
		; ブラウザか（閉じるときはタブだけにする）
		br_is = (fgexe = "chrome.exe") | (fgexe = "msedge.exe") | (fgexe = "firefox.exe") | (fgexe = "brave.exe") | (fgexe = "vivaldi.exe") | (fgexe = "opera.exe")
		if closetest & (instr(cmd, 0, "brclose") >= 0) : br_is = 1
		gosub *dl_match
		; 確認用：brclose は、前面の窓をサボり先とみなしてブラウザの閉じかたを通す（キーは送らず dbg に書く）
		if closetest & br_is : hit = 1
		if hit & slack_stop : slack_now = 1
		if hit {
			dsec++
		} else {
			dsec = 0
		}
		; 長く開いていたら、予告してから最小化するか閉じる（メニューで選ぶ。最初は「しない」）
		if closetest : dbg += strf("C f=%d hit=%d dsec=%d mode=%d fg=%d", frame, hit, dsec, close_mode, fgh) + "\n"
		if hit & (close_mode != 0) {
			lim = close_min * 60
			if dmin(hiti) > 0 : lim = dmin(hiti) * 60
			if closetest : lim = 20
			if closetest & br_is : lim = 8
			warnat = lim - 60
			if warnat < lim / 2 : warnat = lim / 2
			if dsec = warnat {
				if close_mode = 1 : bubble = "そろそろしまうぞ" : bubt = 120
				if close_mode = 2 : bubble = "あと少しで閉じるぞ" : bubt = 120
				if (close_mode = 2) & br_is : bubble = "あと少しでタブを閉じるぞ" : bubt = 120
			}
			if dsec >= lim {
				cl_done = 1
				if close_mode = 1 : ShowWindow fgh, 6 : bubble = "しまっといたぞ" : bubt = 90
				if (close_mode = 2) & (br_is = 0) {
					; 閉じるときは×ボタンを押したのと同じ通知（WM_SYSCOMMAND / SC_CLOSE）を送る。保存の確認はアプリ側が出す
					PostMessage fgh, 0x112, 0xF060, 0 : bubble = "閉じといたぜ" : bubt = 90
					if closetest : dbg += strf("CLOSE sent stat=%d to=%d", stat, fgh) + "\n"
				}
				if (close_mode = 2) & br_is {
					; ブラウザは窓ごと閉じずに、いま見ているタブだけ閉じる（Ctrl+W）
					; キーはそのとき前面の窓に届く。前面がまだそのブラウザで、Shift・Ctrl・Alt・Win・マウスの左ボタンを押していないときだけ送る（Shift で Ctrl+Shift+W になると窓ごと閉じる）。だめなら次の1秒にもう一度
					br_ok = (fg_root() = fgh)
					repeat 6
						k = 0x10 + cnt
						if cnt >= 3 : k = 0x5B + cnt - 3
						if cnt = 5 : k = 0x01
						if GetAsyncKeyState(k) & 0x8000 : br_ok = 0
					loop
					if br_ok {
						if testmode {
							dbg += "CTRLW to=" + fgexe + "\n"
						} else {
							keybd_event 0x11, 0, 0, 0 : keybd_event 0x57, 0, 0, 0
							keybd_event 0x57, 0, 2, 0 : keybd_event 0x11, 0, 2, 0
						}
						bubble = "タブを閉じといたぜ" : bubt = 90
					} else {
						cl_done = 0
						if closetest : dbg += "CTRLW wait\n"
					}
				}
				if cl_done : dsec = 0
			}
		}
		; 5分（scold_sec）続けて前面にあったら、注意しに行く。ちょっと見るくらいでは来ない
		if (dsec >= scold_sec) & (scoldcool = 0) & (state != ST_SCOLD) & (state != ST_ALARM) & (dragging = 0) & (state != ST_CLIMB) & (state != ST_BEHIND) {
			scoldh = fgh : state = ST_SCOLD : stimer = 0 : scoldt = 0 : scoldcool = 60 * 60 * 10 : bubble = "おーい" : bubt = 40 : evc(EV_SCOLD)++
		}
		; 直近5分で30回以上切り替えていたら、ひとこと
		nrec = 0
		repeat 64
			if (swlog(cnt) > 0) & (frame - swlog(cnt) < 18000) : nrec++
		loop
		if (nrec >= 30) & (switchcool = 0) : bubble = "ひとつずついこうぜ" : bubt = 80 : switchcool = 60 * 60 * 5
	}
	return

; 題名（ttl0：小文字）とアプリ名（ttl：題名＋" "＋exe 名）が、サボり先の語に当たるか（hit・hiti）
; 「/ x」のように / で始まる語は、題名の終わりか「 - 」（ブラウザ名の前）の直前にあるときだけ当てる
; （「TODO / xyz」のような題名に当たらないように）
*dl_match
	hit = 0 : hiti = 0
	repeat ndl
		dw = dlist(cnt)
		if strmid(dw, 0, 1) = "/" {
			dwl = strlen(dw) : tl = strlen(ttl0)
			if tl >= dwl {
				if strmid(ttl0, tl - dwl, dwl) = dw : hit = 1 : hiti = cnt : break
			}
			if instr(ttl0, 0, dw + " - ") >= 0 : hit = 1 : hiti = cnt : break
		} else {
			if instr(ttl, 0, dw) >= 0 : hit = 1 : hiti = cnt : break
		}
	loop
	return

*load_distract
	ndl = 0
	exist datadir + "\\distract.txt"
	if strsize < 0 {
		sdim dtxt, 1024
		dtxt = "# 作業中に前面にあったら注意する語（ウィンドウのタイトルかアプリ名に含まれる語。1行に1つ。#で始まる行は無視）\n# 「youtube=10」のように書くと、その語だけ、閉じる（最小化する）までの分数を変えられる\nyoutube\nニコニコ\ntwitch\n/ x\n"
		notesel dtxt : notesave datadir + "\\distract.txt" : noteunsel
	}
	sdim dtxt, 8192
	notesel dtxt
	noteload datadir + "\\distract.txt"
	repeat notemax
		noteget dl, cnt
		dl = getpath(strtrim(dl), 16)
		if dl = "" : continue
		if peek(dl, 0) = '#' : continue
		dmn = 0
		pe = instr(dl, 0, "=")
		if pe > 0 : dmn = int(strmid(dl, pe + 1, 8)) : dl = strmid(dl, 0, pe) : dl = strtrim(dl)
		if ndl < 32 : dlist(ndl) = dl : dmin(ndl) = dmn : ndl++
	loop
	noteunsel
	return
