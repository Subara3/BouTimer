; 作業のおとも、棒人間：ふるまい（何をするかを決める）
; main.hsp から #include で読み込む（ラベルだけのファイル。上から流れては実行されない）

; ---- ふるまい（地面にいるとき） ----
*brain
	stimer++
	; 小さなしぐさは、決めた長さが過ぎるか、ほかの状態になったらやめる
	if pose_t > 0 : pose_t--
	if (pose_t <= 0) | (state != ST_IDLE) : pose_kind = 0
	if (behindh != 0) & (state != ST_BEHIND) : gosub *restore_front
	if (hangoff != 0) & ((state != ST_ACT) | (act != ACT_HANG)) : hangoff = 0
	if state = ST_BEHIND : gosub *behind_brain : return
	; カーソルが重なっているあいだは、つまんだりクリックしたりしやすいように、その場で立ち止まる
	if hovering & (dragging = 0) & (showmode = 0) {
		hv_stop = (state = ST_WALK) | (state = ST_GOTO) | (state = ST_IDLE) | (state = ST_FRONT)
		if state = ST_ACT {
			; 紙を投げる・伸び・ぶら下がり・窓の裏・非常口は、とちゅうでやめると位置や持ち物がおかしくなるので続ける
			hv_stop = (act != ACT_TOSS) & (act != ACT_STRETCH) & (act != ACT_HANG) & (act != ACT_BEHIND) & (act != ACT_EXIT)
		}
		if hv_stop {
			state = ST_IDLE : stimer = 0 : vx = 0.0 : pose_kind = 0
			think = 90
			return
		}
	}
	if boot_t > 0 {
		if (state = ST_WALK) & ((frame \ 5400) = 450) : bubble = "片っぽだけ長靴だぜ" : bubt = 50
	}
	if (state != ST_FRONT) & (state != ST_WAVE) : vx = 0.0
	if state = ST_ALARM {
		; 手前の窓の上まで行って、時刻の札を上げる（一時停止中や休憩中でも）
		if alt = 0 {
			okrect = 0
			if alh : onh_bak = onh : onh = alh : gosub *getrect_on : onh = onh_bak
			if (okrect = 0) | (onh = alh) | (stimer > 300) {
				alt = stimer
			} else {
				; 最大化されている窓や、上辺が画面の上端にある窓には乗れないので、その場で知らせる
				if IsZoomed(alh) | (rc(1) < wa(1) + 40) {
					alt = stimer
				} else {
					tx = (rc(0) + rc(2)) / 2 : ty = rc(1)
					if jumpcd = 0 : gosub *jump_to
					return
				}
			}
		}
		k = stimer - alt
		if (k \ 240) = 120 : bubble = al_text : bubt = 110
		if (k \ 240) = 0 : bubble = al_time + "だぞ！" : bubt = 60
		if k > 720 {
			state = ST_IDLE : stimer = 0 : alt = 0 : bubble = "忘れんなよ！" : bubt = 60
			if testmode : dbg += "ALARM END\n"
		}
		return
	}
	if paused {
		if autopaused {
			if (state != ST_POKED) | (stimer > 40) : state = ST_SLEEP
		} else {
			state = ST_PAUSE
		}
		return
	}
	if state = ST_PAUSE : state = ST_IDLE
	if hop > 0 {
		vy = -7.0 : onh = 0 : hop-- : state = ST_CHEER
		return
	}
	if state = ST_CHEER : state = ST_IDLE : stimer = 0
	if state = ST_LAND {
		if stimer > 75 : state = ST_IDLE : stimer = 0
		return
	}
	if state = ST_DIZZY {
		if stimer > 150 : state = ST_IDLE : stimer = 0
		return
	}
	if state = ST_HAPPY {
		if stimer > 90 : state = ST_IDLE : stimer = 0
		return
	}
	if state = ST_CALL {
		if stimer > 150 : state = ST_IDLE : stimer = 0
		return
	}
	if state = ST_SIGN {
		if stimer > 150 : state = ST_IDLE : stimer = 0 : signcool = 600
		return
	}
	; しばらく文字を打っていたら、文字カーソルの上の窓まで来てのぞきこむ
	if (phase = 0) & (peek_cd <= 0) & caret_ok & (caret_moves > 6.0) & ((state = ST_IDLE) | (state = ST_WALK) | (state = ST_TYPE)) & (showmode = 0) {
		peek_cd = 60 * 60 * 5
		gosub *peek_start
		if state = ST_GOTO : return
	}
	if state = ST_TYPE {
		; 打ち始めのひとこと（毎回ちがうものを。前と同じにはしない）
		if stimer = 1 {
			ty_k0 = keys_session
			if ty_last < 0 {
				ty_k = rnd(NTYOPEN)
			} else {
				ty_k = rnd(NTYOPEN - 1) : if ty_k >= ty_last : ty_k++
			}
			ty_last = ty_k
			bubble = tyopen(ty_k) : bubt = 70
		}
		if (frame - lastkey > 120) | (stimer > 1200) : state = ST_IDLE : stimer = 0 : typecool = 3600
		; 打っているあいだは、いっしょにカタカタ（長さを変えて）
		if ((stimer \ 150) = 1) & (stimer > 1) {
			bubble = "カタカタ"
			if ((stimer / 150) \ 3) = 1 : bubble = "カタカタカタカタ"
			if ((stimer / 150) \ 3) = 2 : bubble = "カタカタ…ターン"
			bubt = 50
		}
		; 速いのは、16秒ならして1秒に10キーをこえたときだけ。言うのは1時間に1回まで
		if ty_fast > 0 : ty_fast--
		if (stimer = 960) & (ty_fast = 0) & (frame - lastkey < 30) {
			if (keys_session - ty_k0) * 60 / stimer >= 10 : ty_fast = 60 * 60 * 60 : bubble = "速いな～！" : bubt = 50
		}
		return
	}
	; 大ジャンプで飛び乗ったあと、ねらった窓に着いていたらのぞきこむ
	if peek_land {
		peek_land_t--
		if onh = peek_land {
			peek_land = 0 : state = ST_PEEK : stimer = 0 : bubble = "おっ、進んでるな" : bubt = 90
			return
		}
		if peek_land_t <= 0 : peek_land = 0
	}
	if state = ST_PEEK {
		if stimer > 240 : state = ST_IDLE : stimer = 0
		return
	}
	if state = ST_GOTO {
		gosub *goto_step
		; 文字カーソルへ向かう途中であきらめたときは、何も言わない（頼まれて行ったわけではないので）
		if gt_mode & (state != ST_GOTO) & testmode : dbg += strf("PEEK give up f=%d st=%d cn=%d goal=%d pathn=%d ", frame, state, cn, goal, pathn) + bubble + "\n"
		if gt_mode & (state != ST_GOTO) {
			gt_mode = 0 : bubble = "" : bubt = 0
			; 道がなくても、のぞきに行くときだけは大ジャンプで飛び乗る
			if (pathn = 0) & (goal >= 0) {
				tx = limit(caret_x, nd_l(goal) + 12, nd_r(goal) - 12) : ty = nd_t(goal)
				gosub *jump_to
				state = ST_IDLE : bubble = "よっと！" : bubt = 50
				peek_land = nd_h(goal) : peek_land_t = 60 * 8
			}
		}
		return
	}
	if state = ST_SCOLD {
		onh_bak = onh : onh = scoldh : gosub *getrect_on : onh = onh_bak
		if (okrect = 0) | (stimer > 900) : state = ST_IDLE : stimer = 0 : scoldt = 0 : return
		; 最大化されていたら上に乗れないので、その場で掲げる
		if (onh = scoldh) | IsZoomed(scoldh) {
			if scoldt = 0 : scoldt = stimer : signtext = "作業しようぜ～？"
			if stimer - scoldt > 240 : state = ST_IDLE : stimer = 0 : scoldt = 0 : bubble = "あとでな！" : bubt = 50
			return
		}
		tx = (rc(0) + rc(2)) / 2 : ty = rc(1)
		if jumpcd = 0 : gosub *jump_to
		return
	}
	if state = ST_GROOVE {
		if musicfr < 60 : state = ST_IDLE : stimer = 0 : bubble = "いい曲だった" : bubt = 50
		; やることが片づいたら、ノるのをやめて紙を捨てに行く
		if toss_pending : state = ST_IDLE : stimer = 0
		; 動画を流しっぱなしのときもあるので、ノるのは2分まで（黙ってやめる）
		if stimer > 60 * 120 : state = ST_IDLE : stimer = 0
		return
	}
	; 曲にノるのは60分に1回まで
	if (musicfr >= 180) & (frame >= groove_next) & (bubt <= 0) & (diary_ask = 0) & (toss_pending = 0) & ((state = ST_IDLE) | (state = ST_WALK)) & (phase = 0) & (showmode = 0) {
		state = ST_GROOVE : stimer = 0 : bubble = "お、いい曲" : bubt = 60 : evc(EV_GROOVE)++
		groove_next = frame + 60 * 60 * 60
		return
	}
	; 打ち込み具合に反応する
	if (state != ST_ACT) & (state != ST_POKED) & (state != ST_ANGRY) & (state != ST_WAVE) & (state != ST_FRONT) {
		if (phase = 0) & (krate > 2.5) & (typecool = 0) {
			state = ST_TYPE : stimer = 0
			return
		}
		if (phase = 1) & (frame - lastkey < 30) & (krate > 1.5) & (signcool = 0) {
			state = ST_SIGN : stimer = 0 : bubble = "" : bubt = 0 : signtext = "休憩しようぜ"
			return
		}
	}
	if state = ST_POKED {
		if stimer > 40 {
			stimer = 0
			if pokes >= 4 {
				state = ST_ANGRY
			} else {
				state = ST_IDLE
			}
		}
		return
	}
	if state = ST_ANGRY {
		if stimer > 60 {
			; ぷいっと離れていく
			state = ST_WALK : stimer = 0 : fastwalk = 90 : think = 90 : pokes = 0
			if mx < int(cx) + CW / 2 {
				wdir = 1
			} else {
				wdir = -1
			}
		}
		return
	}
	if state = ST_WAVE {
		if stimer > 90 : state = ST_REST : stimer = 0
		return
	}
	if state = ST_FRONT {
		if stimer > 330 : state = ST_IDLE : stimer = 0
		return
	}
	if state = ST_ACT {
		gosub *act_brain
		return
	}
	; やることが片づいたら、紙を丸めて捨てる（休憩中でも）
	if toss_pending : toss_pending = 0 : act = ACT_TOSS : gosub *start_act : return
	if phase = 1 {
		gosub *go_rest
		return
	}
	if state = ST_REST : state = ST_IDLE
	if state = ST_SLACK {
		if stimer > sdur {
			stimer = 0
			if rnd(2) {
				state = ST_SLEEP : sdur = 300 + rnd(400) : evc(EV_NAP)++
			} else {
				state = ST_IDLE
			}
		}
		return
	}
	if state = ST_SLEEP {
		if stimer > sdur : state = ST_IDLE : stimer = 0
		return
	}
	; 休憩をとらずに長く続けていたら、伸びをして合図する
	if stretch_due : stretch_due = 0 : act = ACT_STRETCH : gosub *start_act : return
	if stand_due : stand_due = 0 : stand_msg = 1 : act = ACT_STRETCH : gosub *start_act : return
	; 一定時間ごとにお茶（何か言っている途中なら、言い終わるまで待つ）
	if (frame >= next_tea) & (bubt <= 0) {
		act = ACT_TEA : gosub *start_act
		return
	}
	gosub *wander
	return

*start_act
	; 珠音のドット絵のときは、道具を使う動きはしない（絵がないので）。代わりに少しよろこぶ
	if (costume = 1) & (tama_img != 0) & (act != ACT_STRETCH) & (act != ACT_TOSS) & (act != ACT_HANG) & (act != ACT_BEHIND) {
		if act = ACT_TEA {
			next_tea = frame + tea_every
			if act_level = 1 : next_tea = frame + tea_every * 3 / 2
			if act_level = 0 : next_tea = frame + tea_every * 3
		}
		if testmode : dbg += "TAMA skip act=" + act + "\n"
		state = ST_IDLE : stimer = 0 : vx = 0.0 : pose_kind = 1 : pose_t = 120
		return
	}
	state = ST_ACT : stimer = 0 : vx = 0.0
	sdur = 300
	if act = ACT_TEA {
		sdur = 420 : ln_k = 3 : gosub *pick_line : bubble = ln_out : bubt = 70 : evc(EV_TEA)++
		; 動きの多さが「ときどき」なら1.5倍、「なし」なら3倍あけて飲む
		next_tea = frame + tea_every
		if act_level = 1 : next_tea = frame + tea_every * 3 / 2
		if act_level = 0 : next_tea = frame + tea_every * 3
	}
	if act = ACT_STICK {
		sdur = 420
		; 棒の使いみちはウィンドウの種で決まる
		stickuse = (wseed >> 5) \ 4
		if showmode : stickuse = (actn / NACT) \ 4
		; 釣れるもの：0小魚 1金魚 2長靴 3空き缶 4大物
		r = rnd(100)
		catchk = 0
		if r >= 45 : catchk = 1
		if r >= 60 : catchk = 2
		if r >= 80 : catchk = 3
		if r >= 95 : catchk = 4
	}
	if act = ACT_PUSHUP : sdur = 320
	if act = ACT_READ : sdur = 420
	if act = ACT_SWEEP : sdur = 300
	if act = ACT_DANCE : sdur = 260 : bubble = "♪" : bubt = 60
	if act = ACT_WIPE : sdur = 260 : bubble = "あちっ！" : bubt = 50 : evc(EV_SPILL)++
	if act = ACT_FLAT : sdur = 90 : bubble = "ぐえっ" : bubt = 50
	if act = ACT_KICKCAN : sdur = 200
	if act = ACT_AQUA : sdur = 380 : bubble = "かわいいな" : bubt = 60
	if act = ACT_EXIT : sdur = 150 : bubble = "非常口" : bubt = 80
	if act = ACT_HANG : sdur = 330 : bubble = "よっ" : bubt = 40
	if act = ACT_BEHIND : sdur = 99999 : bubble = "ん？" : bubt = 50 : evc(EV_BEHIND)++
	if act = ACT_ICONBALL : sdur = 300
	if act = ACT_PPAP : sdur = 300 : dir = 1 : evc(EV_PPAP)++
	if act = ACT_EXERCISE : sdur = 480 : dir = 1
	if act = ACT_FLIP : sdur = 40 : flip_t = frame : vy = -7.5 * uis : onh = 0 : vx = 0.0 : bubble = "ほっ" : bubt = 30
	if act = ACT_FAN : sdur = 260 : dir = 1
	if act = ACT_YAWN : sdur = 150 : dir = 1 : bubble = "ふぁ～" : bubt = 70
	if act = ACT_ICONJUG : sdur = 320 : dir = 1 : bubble = "お手玉～" : bubt = 70
	; アイコンタワー：1つ45コマで投げて積み、ぐらぐらして、崩れる
	if act = ACT_ICONTOWER : itw_done = icn * 45 + 10 : sdur = itw_done + 140 : dir = 1 : bubble = "タワーだ！" : bubt = 70
	if act = ACT_SEASON : sdur = 360
	if act = ACT_STRETCH {
		sdur = 400 : bubble = "ちょっと伸びようぜ" : bubt = 90
		if stand_msg : stand_msg = 0 : bubble = "そろそろ立って、伸びようぜ" : bubt = 110
		; どちらの合図で伸びても、両方の数えをやりなおす（続けて2回伸びないように）
		stand_ms = 0 : stretch_next = cont_ms + 30 * 60000
	}
	if act = ACT_TOSS {
		sdur = 220 : bubble = "" : bubt = 0
		; 丸めた紙が届くように、ゴミ箱を置く向きを決める（足場の端に近いときは内側へ）
		if onh {
			fxx = int(cx) + CW / 2
			if (dir > 0) & (fxx + int(70.0 * uis) > onr) : dir = -1
			if (dir < 0) & (fxx - int(70.0 * uis) < onl) : dir = 1
		}
	}
	if act >= ACT_ROPE : gosub *play_start
	if showmode = 0 : actn++
	return

*got_catch
	evc(EV_FISH + catchk)++
	if catchk = 0 : bubble = "よし、飼うか" : aq_n++
	if catchk = 1 : bubble = "金魚だ、珍しいな" : aq_n++ : aq_gold++
	if catchk = 2 : bubble = "長靴だ！はいてみよ" : boot_t = 1 : boot_day = today : gosub *save_settings
	if catchk = 3 : bubble = "空き缶だ！蹴ろう"
	if catchk = 4 : bubble = "大物だ！" : aq_n++ : aq_big++
	bubt = 70
	if aq_n > 12 : aq_n = 12
	gosub *save_settings
	return

*restore_front
	SetWindowPos myhwnd, -1, 0, 0, 0, 0, 0x13
	behindh = 0 : ignoreh = 0
	return

; 裏側に落ちたあと：ウィンドウの外まで歩いて出てきて、飛び乗って戻る
*behind_brain
	onh_bak = onh : onh = behindh : gosub *getrect_on : onh = onh_bak
	if okrect = 0 : gosub *restore_front : state = ST_IDLE : return
	if stimer > 60 * 15 : gosub *restore_front : state = ST_IDLE : stimer = 0 : bubble = "ただいま" : bubt = 60 : return
	fx = int(cx) + CW / 2
	if (fx > rc(0) - 14) & (fx < rc(2) + 14) {
		if stimer = 1 : bubble = "探検だ～" : bubt = 60
		if (rc(0) + rc(2)) / 2 > fx {
			vx = -1.4
		} else {
			vx = 1.4
		}
		return
	}
	gosub *restore_front
	bubble = "ただいま" : bubt = 60
	if fx < rc(0) {
		tx = rc(0) + 30
	} else {
		tx = rc(2) - 30
	}
	ty = rc(1) : state = ST_IDLE : gosub *jump_to
	return

*act_brain
	if stimer > sdur {
		state = ST_IDLE : stimer = 0 : think = 30
		if act = ACT_STICK : bubble = "ほいっと" : bubt = 40
		if act = ACT_TEA : ln_k = 4 : gosub *pick_line : bubble = ln_out : bubt = 50
		if act = ACT_WIPE : bubble = "よし、元通りだ" : bubt = 60
		if act = ACT_AQUA : bubble = "よく食うな" : bubt = 60

		if act = ACT_ICONBALL : bubble = "返しとくぞ" : bubt = 50
		if act = ACT_ICONJUG : bubble = "返しとくぞ" : bubt = 50
		if act = ACT_FLIP : bubble = "シュタッ" : bubt = 40
		if act = ACT_EXERCISE : bubble = "よし、すっきりした" : bubt = 60
		if act = ACT_FAN : bubble = "これで冷えるかな" : bubt = 60
		if act = ACT_YAWN : bubble = "…眠いな" : bubt = 50
		if act = ACT_ICONTOWER : bubble = "片づけとこ" : bubt = 50
		if act >= ACT_ROPE : gosub *play_end
		if act = ACT_STRETCH : bubble = "よし、もうひと息！" : bubt = 60
		if act = ACT_TOSS {
			gosub *todo_first
			if todo_top >= 0 {
				bubble = "次いこうぜ" : bubt = 60
			} else {
				bubble = "全部片づいたな！" : bubt = 80 : celebrate = 150
			}
		}
		if act = ACT_HANG : hangoff = 0
		; 空き缶を釣ったら、そのまま蹴っ飛ばす
		if (act = ACT_STICK) & (stickuse = USE_FISH) & (catchk = 3) : act = ACT_KICKCAN : gosub *start_act : bubt = 0
		return
	}
	if act = ACT_STICK {
		if stimer = 1 : bubble = "お？" : bubt = 40
		if (stickuse = USE_CANE) & (stimer > 80) & (stimer < 380) {
			vx = 0.6 * wdir
			if onh {
				nfx = int(cx + vx) + CW / 2
				if (nfx < onl + 10) | (nfx >= onr - 10) : wdir = -wdir : vx = -vx
			}
		}
		if (stickuse = USE_SWORD) & ((stimer \ 70) = 20) & (stimer > 80) : bubble = "せいっ" : bubt = 25
		if (stickuse = USE_TAP) & ((stimer \ 100) = 90) & (stimer > 80) : bubble = "コンコン" : bubt = 40
		if (stickuse = USE_FISH) & (stimer = 300) : bubble = "かかった！" : bubt = 50
		if (stickuse = USE_FISH) & (stimer = 330) : gosub *got_catch
	}
	if act = ACT_PUSHUP {
		if ((stimer \ 52) = 26) & (stimer > 40) : bubble = str((stimer - 40) / 52 + 1) : bubt = 30
	}
	if act = ACT_DANCE {
		if (stimer \ 40) = 0 : dir = -dir
	}
	if act = ACT_KICKCAN {
		if stimer = 20 : bubble = "そらっ" : bubt = 30
		if stimer = 140 : bubble = "カーン" : bubt = 40
	}
	if act = ACT_AQUA {
		if stimer = 170 : bubble = "ほら、メシだ" : bubt = 50
	}
	if act = ACT_HANG {
		hangoff = 0
		if (stimer >= 20) & (stimer < 40) : hangoff = (stimer - 20) * 3
		if (stimer >= 40) & (stimer < 290) : hangoff = 58
		if stimer >= 290 : hangoff = limit(58 - (stimer - 290) * 58 / 40, 0, 58)
		if stimer = 120 : bubble = "ぶらーん" : bubt = 60
		if stimer = 295 : bubble = "よいしょ" : bubt = 50
	}
	if act = ACT_BEHIND {
		if stimer = 50 {
			; 自分の重なり順を、乗っているウィンドウのすぐ後ろにする
			behindh = onh : ignoreh = onh
			SetWindowPos myhwnd, -2, 0, 0, 0, 0, 0x13
			SetWindowPos myhwnd, behindh, 0, 0, 0, 0, 0x13
			onh = 0 : vy = -4.0 : state = ST_BEHIND : stimer = 0
		}
	}
	if act = ACT_STRETCH {
		if stimer = 150 : bubble = "横にも、ぐいーっと" : bubt = 80
		if stimer = 270 : bubble = "遠くを見ると目が休まるぞ" : bubt = 110
	}
	if act = ACT_TOSS {
		if stimer = 10 : bubble = "くしゃくしゃっと" : bubt = 50 : se_name = "se_paper" : gosub *se_play
		if stimer = 150 : bubble = "ナイスシュート！" : bubt = 60 : se_name = "se_goal" : gosub *se_play
	}
	if act >= ACT_ROPE : gosub *play_brain
	if act = ACT_ICONJUG {
		if stimer = 160 : bubble = "ほっ、ほっ" : bubt = 50
	}
	if act = ACT_EXERCISE {
		; 4つの動きを2回ずつ。かけ声は動きの頭で
		if (stimer >= 90) & ((stimer \ 30) = 0) {
			exn = (stimer - 90) / 30
			if exn < 12 {
				if (exn \ 4) = 0 : bubble = "いち" : bubt = 25
				if (exn \ 4) = 1 : bubble = "に" : bubt = 25
				if (exn \ 4) = 2 : bubble = "さん" : bubt = 25
				if (exn \ 4) = 3 : bubble = "し" : bubt = 25
			}
		}
	}
	if act = ACT_FLIP {
		; 跳んでいるあいだは数えないので、回りきる前に着いたら少し待つ
		if frame - flip_t < 40 : stimer = 0
	}
	if act = ACT_ICONTOWER {
		if stimer = itw_done : bubble = "高いぞ～！" : bubt = 50
		if stimer = itw_done + 40 : bubble = "ぐらぐらする…" : bubt = 40
		if stimer = itw_done + 66 : bubble = "あっ" : bubt = 40
	}
	if act = ACT_PPAP {
		if stimer = 1 : bubble = "アイハブアアイコン" : bubt = 60
		if stimer = 70 : bubble = "アイハブアアイコン" : bubt = 60
		if stimer = 140 : bubble = "うーん…" : bubt = 50
		if stimer = 195 : bubble = "合体！" : bubt = 90
	}
	return

; ---- 作業中：勝手に歩き回る ----
*wander
	think--
	if think > 0 : goto *wander_move
	think = rnd(150) + 60
	; 動きの多さ：ときどき（1）は間を長くあける。なし（0）はその場で立つか座るだけ
	if act_level = 1 : think = rnd(420) + 240
	if (act_level = 0) & (showmode = 0) {
		think = rnd(900) + 600
		if rnd(3) = 0 {
			state = ST_SLACK : stimer = 0 : sdur = 300 + rnd(600)
		} else {
			state = ST_IDLE
		}
		goto *wander_move
	}
	; 「絵日記、書くか？」と聞いているあいだは、新しい遊びを始めない（セリフが上書きされるので）
	if diary_ask > 0 : state = ST_IDLE : goto *wander_move
	if showmode {
		; 見た目確認用：小さな動きを順番に
		think = 40
		gosub *show_next
		return
	}
	if rnd(100) < 6 {
		; メモ帳で直したぶんも拾えるように、言う前に読み直す
		gosub *load_kotoba
		if nkoto > 0 : bubble = kotoba(rnd(nkoto)) : bubt = 120
	}
	if (sea_kind != 0) & (rnd(100) < 8) {
		act = ACT_SEASON : gosub *start_act
		sea_show = 60 * 10
		return
	}
	r2 = rnd(100)
	if r2 < 4 {
		act = ACT_EXIT : gosub *start_act
		return
	}
	if (r2 < 9) & (onh != 0) {
		act = ACT_HANG : gosub *start_act
		return
	}
	if (r2 < 13) & (onh != 0) & (ont < ground - 150) {
		act = ACT_BEHIND : gosub *start_act
		return
	}
	if r2 < 18 {
		gosub *ensure_icons
		if icok(0) {
			act = ACT_ICONBALL : gosub *start_act
			return
		}
	}
	if r2 < 22 {
		gosub *ensure_icons
		if icok(0) & icok(1) {
			act = ACT_PPAP : gosub *start_act
			return
		}
	}
	if ((gettime(4) >= 23) | (gettime(4) < 4)) & (rnd(100) < 8) {
		act = ACT_YAWN : gosub *start_act
		return
	}
	if (gettime(4) = 12) & (lunch_day != curday) {
		lunch_day = curday
		act = ACT_ONIGIRI : gosub *start_act : bubble = "お昼だな、腹へった" : bubt = 70
		return
	}
	if r2 < 25 {
		gosub *ensure_icons_many
		if icn >= 3 : act = ACT_ICONJUG : gosub *start_act : return
	}
	if r2 < 28 {
		gosub *ensure_icons_many
		if icn >= 2 : act = ACT_ICONTOWER : gosub *start_act : return
	}
	if (aq_n > 0) & (rnd(100) < 10) {
		act = ACT_AQUA : gosub *start_act
		return
	}
	r = rnd(100)
	if r < 34 {
		state = ST_WALK : wdir = rnd(2) * 2 - 1
		goto *wander_move
	}
	if r < 46 {
		state = ST_IDLE
		; ときどき考えこんだり、頭をかいたりする
		r2 = rnd(10)
		if r2 < 2 : pose_kind = 2 : pose_t = 180 + rnd(180) : if rnd(2) = 0 : bubble = "うーん…" : bubt = 70
		if r2 = 2 : pose_kind = 3 : pose_t = 120
		goto *wander_move
	}
	if r < 54 {
		state = ST_SLACK : stimer = 0 : sdur = 120 + rnd(180) : ln_k = 7 : gosub *pick_line : bubble = ln_out : bubt = 90
		return
	}
	if r < 61 {
		state = ST_FRONT : stimer = 0
		return
	}
	if r < 84 {
		; 何をするかは、乗っているウィンドウの種から引く
		act = ((wseed >> ((actn \ 8) * 3)) + rnd(2) * rnd(NACT)) \ NACT
		if act = ACT_TEA : act = ACT_STICK
		; ときどき、あそびの動き（どれが出やすいかも窓の種で変わる）
		if rnd(100) < 40 : act = ACT_ROPE + ((wseed >> 11) + rnd(3)) \ NPLAY
		gosub *start_act
		return
	}
	; 近くの上にあるウィンドウへ飛び移る
	gosub *scan_platforms
	fx = int(cx) + CW / 2 : foot = int(cy) + FOOTY
	best = -1
	repeat nplat
		if plat_h(cnt) = onh : continue
		up = foot - plat_t(cnt)
		if (up > 20) & (up < 240) {
			tx = limit(fx, plat_l(cnt) + 20, plat_r(cnt) - 20)
			if abs(tx - fx) < 280 : best = cnt : break
		}
	loop
	if best >= 0 {
		tx = limit(fx, plat_l(best) + 20, plat_r(best) - 20) : ty = plat_t(best)
		gosub *jump_to
		return
	}
	state = ST_IDLE

*wander_move
	if state = ST_WALK {
		sp = 1.3
		if fastwalk > 0 : sp = 3.0 : fastwalk--
		vx = sp * wdir
		; ウィンドウの端では、たいてい引き返す（たまに落ちる）
		if onh {
			nfx = int(cx + vx) + CW / 2
			if (nfx < onl + 6) | (nfx >= onr - 6) {
				if rnd(4) : wdir = -wdir : vx = -vx
			}
		}
	} else {
		; 立ち止まっているときは、近くのカーソルの方を向く
		if abs(mx - (int(cx) + CW / 2)) < 250 {
			if mx < int(cx) + CW / 2 {
				dir = -1
			} else {
				dir = 1
			}
		}
	}
	return

*show_next
	k = actn
	if k < NACT * 4 {
		; 棒の使いみち4通りを含めて一巡
		act = k \ NACT
		if (k >= NACT) & (act != ACT_STICK) : actn++ : goto *show_next
		actn++
		gosub *start_act
		sdur = 220
		return
	}
	k -= NACT * 4
	actn++
	if k = 0 : state = ST_FRONT : stimer = 0 : return
	if k = 1 : state = ST_SLACK : stimer = 0 : sdur = 100 : bubble = "ちょいとサボるか" : bubt = 90 : return
	if k = 2 : state = ST_TYPE : stimer = 0 : lastkey = frame + 120 : krate = 8.0 : return
	if k = 3 : state = ST_SIGN : stimer = 0 : return
	if k = 4 : state = ST_DIZZY : stimer = 0 : bubble = "うおお、揺れる～" : bubt = 60 : return
	if k = 5 : state = ST_HAPPY : stimer = 0 : bubble = "へへっ、くすぐってえ" : bubt = 70 : return
	if k = 6 : state = ST_CALL : stimer = 0 : bubble = "おーい、どこ行った～？" : bubt = 90 : return
	if k = 7 : celebrate = 150 : hop = 3 : bubble = "1個目！やったな" : bubt = 120 : return
	if k = 8 : night = 1 : state = ST_IDLE : bubble = "そろそろ寝ようぜ" : bubt = 120 : return
	if (k >= 9) & (k <= 13) : night = 0 : state = ST_LAND : stimer = 0 : landpose = k - 9 : bubt = 0 : return
	if k = 14 : act = ACT_WIPE : gosub *start_act : return
	if k = 15 : act = ACT_FLAT : gosub *start_act : return
	if k = 16 : act = ACT_STICK : gosub *start_act : stickuse = USE_FISH : catchk = 2 : return
	if k = 17 : act = ACT_STICK : gosub *start_act : stickuse = USE_FISH : catchk = 3 : return
	if k = 18 : act = ACT_STICK : gosub *start_act : stickuse = USE_FISH : catchk = 1 : return
	if k = 19 : act = ACT_AQUA : gosub *start_act : return
	if k = 20 : act = ACT_EXIT : gosub *start_act : return
	if k = 21 : act = ACT_HANG : gosub *start_act : return
	if k = 22 {
		gosub *ensure_icons
		if icok(0) : act = ACT_ICONBALL : gosub *start_act : return
	}
	if k = 23 {
		gosub *ensure_icons
		if icok(0) & icok(1) : act = ACT_PPAP : gosub *start_act : return
	}
	if k = 24 : act = ACT_STRETCH : gosub *start_act : sdur = 400 : return
	if k = 25 : act = ACT_TOSS : gosub *start_act : return
	if (k >= 26) & (k < 26 + NPLAY) : act = ACT_ROPE + k - 26 : gosub *start_act : return
	if k = 26 + NPLAY {
		gosub *ensure_icons_many
		if icn >= 3 : act = ACT_ICONJUG : gosub *start_act : return
	}
	if k = 27 + NPLAY {
		gosub *ensure_icons_many
		if icn >= 2 : act = ACT_ICONTOWER : gosub *start_act : return
	}
	if k = 28 + NPLAY : act = ACT_FLIP : gosub *start_act : return
	if k = 29 + NPLAY : act = ACT_FAN : gosub *start_act : bubble = "PC、あっちいな" : bubt = 70 : return
	if k = 30 + NPLAY : act = ACT_YAWN : gosub *start_act : return
	if k = 31 + NPLAY : act = ACT_EXERCISE : gosub *start_act : return
	state = ST_IDLE
	return

; ---- 休憩：使っているウィンドウのふちへ ----
*go_rest
	h = fg_root()
	if (h != 0) & (h != myhwnd) : tgt = h
	ok = 0
	if tgt {
		if IsWindowVisible(tgt) & (IsIconic(tgt) = 0) {
			onh_bak = onh : onh = tgt : gosub *rect_of_onh : onh = onh_bak
			if (rc(2) - rc(0) >= 160) & (rc(1) > vtop + 60) & (IsZoomed(tgt) = 0) : ok = 1
		}
	}
	if ok = 0 {
		; 行き先がない（最大化など）ときはその場で座る
		gosub *rest_here
		return
	}
	tx = (rc(0) + rc(2)) / 2 + 80
	fx = int(cx) + CW / 2
	if onh = tgt {
		if abs(tx - fx) <= 2 {
			gosub *rest_here
		} else {
			state = ST_WALK
			if tx > fx {
				vx = 1.6
			} else {
				vx = -1.6
			}
		}
		return
	}
	state = ST_IDLE
	if jumpcd = 0 {
		rest_try++
		if rest_try > 4 : gosub *rest_here : return
		ty = rc(1) : gosub *jump_to
	}
	return

; 見失ったときに呼ぶ（メニュー「ここに呼ぶ」）。いま使っているウィンドウの上に現れて、落ちて乗る
*call_here
	if behindh : gosub *restore_front
	hangoff = 0
	h = fg_root()
	; トレイのアイコンから呼んだときは前面がタスクバーなので、その前に使っていた窓へ
	chk_h = h : gosub *is_shell_win
	if testmode & (instr(cmd, 0, "calltray") >= 0) : is_shell = 1
	if is_shell : h = usefg
	ok = 0
	if (h != 0) & (h != myhwnd) {
		if IsWindowVisible(h) & (IsIconic(h) = 0) {
			onh_bak = onh : onh = h : gosub *rect_of_onh : onh = onh_bak
			if (rc(2) - rc(0) >= 100) & (rc(1) > vtop + 60) : ok = 1
		}
	}
	if ok {
		cx = double((rc(0) + rc(2)) / 2 - CW / 2) : cy = double(rc(1) - FOOTY - 40)
	} else {
		; 使っているウィンドウが最大化などで乗れないときは、画面のまんなかの上から落ちる
		cx = double((wa(0) + wa(2)) / 2 - CW / 2) : cy = double(wa(1) + 60)
	}
	onh = 0 : vx = 0.0 : vy = 0.0 : dragging = 0 : state = ST_IDLE : stimer = 0 : peek_land = 0
	SetWindowPos myhwnd, -1, 0, 0, 0, 0, 0x13
	bubble = "呼んだか？" : bubt = 90
	if testmode : dbg += strf("CALL ok=%d shell=%d h=%d use=%d cx=%d cy=%d", ok, is_shell, h, usefg, int(cx), int(cy)) + "\n"
	return

; よく出るセリフを、組（ln_k：0作業 1休憩 2達成 3茶 4茶のあと 5離席 6おかえり 7サボり）から1つ選ぶ。前と同じは出さない
*pick_line
	if ln_k = 0 : ln_n = 5 : ln_l = ln_wk_last
	if ln_k = 1 : ln_n = 5 : ln_l = ln_rs_last
	if ln_k = 2 : ln_n = 3 : ln_l = ln_pm_last
	if ln_k = 3 : ln_n = 4 : ln_l = ln_tea_last
	if ln_k = 4 : ln_n = 4 : ln_l = ln_teb_last
	if ln_k = 5 : ln_n = 3 : ln_l = ln_idl_last
	if ln_k = 6 : ln_n = 4 : ln_l = ln_ret_last
	if ln_k = 7 : ln_n = 4 : ln_l = ln_slk_last
	; 前と同じものは選ばない（はじめての1回は、どれでも）
	if ln_l < 0 {
		ln_i = rnd(ln_n)
	} else {
		ln_i = rnd(ln_n - 1) : if ln_i >= ln_l : ln_i++
	}
	if ln_k = 0 : ln_wk_last = ln_i : ln_out = ln_wk(ln_i)
	if ln_k = 1 : ln_rs_last = ln_i : ln_out = ln_rs(ln_i)
	if ln_k = 2 : ln_pm_last = ln_i : ln_out = ln_pm(ln_i)
	if ln_k = 3 : ln_tea_last = ln_i : ln_out = ln_tea(ln_i)
	if ln_k = 4 : ln_teb_last = ln_i : ln_out = ln_teb(ln_i)
	if ln_k = 5 : ln_idl_last = ln_i : ln_out = ln_idl(ln_i)
	if ln_k = 6 : ln_ret_last = ln_i : ln_out = ln_ret(ln_i)
	if ln_k = 7 : ln_slk_last = ln_i : ln_out = ln_slk(ln_i)
	return

*rest_here
	if state != ST_REST : state = ST_REST : stimer = 0
	; 休憩に入って少ししたら、ときどき体操（休憩1回につき1回まで）
	if (ex_done = 0) & (stimer > 180) & (rnd(600) = 0) & (break_ms >= 180000) {
		ex_done = 1 : act = ACT_EXERCISE : gosub *start_act : return
	}
	; 休憩中もときどき水槽を眺める
	if (aq_n > 0) & (rnd(2400) = 0) : act = ACT_AQUA : gosub *start_act : return
	; 休憩中もときどきお茶
	if frame >= next_tea : act = ACT_TEA : gosub *start_act
	return
