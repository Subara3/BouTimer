; 作業のおとも、棒人間：やることリスト
; main.hsp から #include で読み込む（ラベルだけのファイル。上から流れては実行されない）

; ---- 文字数で切る（cu_s を cu_n 文字まで。切ったら「…」を付ける） ----
*cut_utf8
	cu_b = 0 : cu_c = 0 : cu_len = strlen(cu_s)
	repeat
		if cu_b >= cu_len : break
		if cu_c >= cu_n : cu_s = strmid(cu_s, 0, cu_b) + "…" : break
		c0 = peek(cu_s, cu_b)
		if c0 < 0x80 {
			cu_b++
		} else {
			if c0 >= 0xF0 {
				cu_b += 4
			} else {
				if c0 >= 0xE0 {
					cu_b += 3
				} else {
					cu_b += 2
				}
			}
		}
		cu_c++
	loop
	return

; ---- やることリスト（todo.txt。「- 」はまだ、「x 日付 」は済み） ----
; 追加した時刻を「- @2026-10-17 14:05 内容」、かかった時間を「x 2026-10-17 [35分] 内容」の形で残す（時刻のない前の形も読める）
*load_todo
	ntodo = 0
	exist datadir + "\\todo.txt"
	if strsize < 0 : return
	sdim ttxt, 16384
	notesel ttxt
	noteload datadir + "\\todo.txt"
	repeat notemax
		noteget tl, cnt
		tl = strtrim(tl)
		if strlen(tl) < 2 : continue
		if ntodo >= 40 : break
		if peek(tl, 0) = '-' {
			; strtrim には式を渡せない（エラー23）ので、いったん tsv に入れてから整える
			tsv = strmid(tl, 1, 255) : tsv = strtrim(tsv) : todo_d(ntodo) = 0 : todo_day(ntodo) = "" : todo_at(ntodo) = "" : todo_min(ntodo) = -1
			if (peek(tsv, 0) = '@') & (strlen(tsv) > 18) : todo_at(ntodo) = strmid(tsv, 1, 16) : tsv = strmid(tsv, 17, 255) : tsv = strtrim(tsv)
			gosub *todo_dly_mark
			todo_s(ntodo) = tsv
			if tsv != "" : ntodo++
			continue
		}
		if (peek(tl, 0) = 'x') & (strlen(tl) > 13) {
			todo_day(ntodo) = strmid(tl, 2, 10) : tsv = strmid(tl, 13, 255) : tsv = strtrim(tsv) : todo_d(ntodo) = 1 : todo_at(ntodo) = "" : todo_min(ntodo) = -1
			; [35分] があれば、かかった時間
			if peek(tsv, 0) = '[' {
				tq2 = instr(tsv, 0, "分]")
				if (tq2 > 1) & (tq2 < 8) : todo_min(ntodo) = int(strmid(tsv, 1, tq2 - 1)) : tsv = strmid(tsv, tq2 + 4, 255) : tsv = strtrim(tsv)
			}
			gosub *todo_dly_mark
			todo_s(ntodo) = tsv
			if tsv != "" : ntodo++
		}
	loop
	noteunsel
	gosub *load_daily
	return

; 「[毎日] 」で始まっていれば、毎日のやることの印を立てて、印を外す
*todo_dly_mark
	todo_dly(ntodo) = 0
	if strmid(tsv, 0, 8) = "[毎日]" : todo_dly(ntodo) = 1 : tsv = strmid(tsv, 8, 255) : tsv = strtrim(tsv)
	return

; ---- 毎日のやること（daily.txt に1行1つ） ----
*load_daily
	ndly = 0
	exist datadir + "\\daily.txt"
	if strsize < 0 : return
	sdim dtxt2, 4096
	notesel dtxt2 : noteload datadir + "\\daily.txt"
	repeat notemax
		noteget dl2, cnt : dl2 = strtrim(dl2)
		if dl2 = "" : continue
		if peek(dl2, 0) = '#' : continue
		if ndly < 20 : dly_s(ndly) = dl2 : ndly++
	loop
	noteunsel
	return

*save_daily
	if testmode & (allow_save = 0) : return
	sdim dtxt2, 4096
	dtxt2 = "# 毎日のやること（1行に1つ。日付が変わると、やることリストに入る）\n"
	repeat ndly
		dtxt2 += dly_s(cnt) + "\n"
	loop
	notesel dtxt2 : notesave datadir + "\\daily.txt" : noteunsel
	return

; 日付が変わったとき（起動したときも）：前の日までに済んだものを消し、毎日のやることを入れる
*todo_newday
	tdn_ch = 0
	tdi = 0
	repeat
		if tdi >= ntodo : break
		if todo_d(tdi) & (todo_day(tdi) != curday) {
			gosub *todo_remove : tdn_ch = 1
		} else {
			tdi++
		}
	loop
	repeat ndly
		tdn_i = cnt : tdn_has = 0
		; まだのもの、または今日済ませたものに同じやることがあれば入れない
		repeat ntodo
			if todo_s(cnt) = dly_s(tdn_i) {
				if (todo_d(cnt) = 0) | (todo_day(cnt) = curday) : tdn_has = 1 : break
			}
		loop
		if (tdn_has = 0) & (ntodo < 40) {
			todo_s(ntodo) = dly_s(tdn_i) : todo_d(ntodo) = 0 : todo_day(ntodo) = "" : todo_min(ntodo) = -1 : todo_dly(ntodo) = 1
			todo_at(ntodo) = strf("%04d-%02d-%02d %02d:%02d", gettime(0), gettime(1), gettime(3), gettime(4), gettime(5)) : ntodo++
			tdn_ch = 1
		}
	loop
	if tdn_ch : gosub *save_todo : gosub *todo_first
	return

*save_todo
	if testmode & (allow_save = 0) : return
	sdim ttxt, 16384
	ttxt = "# やることリスト（「- 」で始まる行がまだ、「x 日付 」で始まる行が済んだもの）\n"
	repeat ntodo
		if todo_d(cnt) {
			tsv2 = todo_s(cnt) : if todo_dly(cnt) : tsv2 = "[毎日] " + tsv2
			if todo_min(cnt) >= 0 {
				ttxt += "x " + todo_day(cnt) + " [" + todo_min(cnt) + "分] " + tsv2 + "\n"
			} else {
				ttxt += "x " + todo_day(cnt) + " " + tsv2 + "\n"
			}
		} else {
			tsv2 = todo_s(cnt) : if todo_dly(cnt) : tsv2 = "[毎日] " + tsv2
			if todo_at(cnt) != "" {
				ttxt += "- @" + todo_at(cnt) + " " + tsv2 + "\n"
			} else {
				ttxt += "- " + tsv2 + "\n"
			}
		}
	loop
	notesel ttxt
	notesave datadir + "\\todo.txt"
	noteunsel
	return

; まだ済んでいない、いちばん上のもの
*todo_first
	todo_top = -1
	repeat ntodo
		if todo_d(cnt) = 0 : todo_top = cnt : break
	loop
	return

*todo_remove
	if (tdi < 0) | (tdi >= ntodo) : return
	; 番号がずれるので、済ませた直後のもどしはやめる
	td_undo = -1
	repeat ntodo - tdi - 1, tdi
		todo_s(cnt) = todo_s(cnt + 1) : todo_d(cnt) = todo_d(cnt + 1) : todo_day(cnt) = todo_day(cnt + 1) : todo_at(cnt) = todo_at(cnt + 1) : todo_min(cnt) = todo_min(cnt + 1) : todo_dly(cnt) = todo_dly(cnt + 1)
	loop
	ntodo--
	return

*todo_add
	td_added = 0
	todo_in = strtrim(todo_in)
	if todo_in = "" : return
	cu_s = todo_in : cu_n = 40 : gosub *cut_utf8 : todo_in = cu_s
	if ntodo >= 40 {
		; いっぱいなら、いちばん古い済んだものを消す
		tdi = -1
		repeat ntodo
			if todo_d(cnt) & (todo_day(cnt) != curday) : tdi = cnt : break
		loop
		if tdi < 0 {
			repeat ntodo
				if todo_d(cnt) : tdi = cnt : break
			loop
		}
		if tdi < 0 : bubble = "もう持ちきれないぞ" : bubt = 80 : return
		gosub *todo_remove
	}
	todo_s(ntodo) = todo_in : todo_d(ntodo) = 0 : todo_day(ntodo) = "" : todo_min(ntodo) = -1 : todo_dly(ntodo) = 0
	if todo_daily_chk & (ndly < 20) {
		; 毎日のやることにも入れる（同じものがなければ）
		tdn_has = 0
		repeat ndly
			if dly_s(cnt) = todo_in : tdn_has = 1
		loop
		if tdn_has = 0 : dly_s(ndly) = todo_in : ndly++ : gosub *save_daily
		todo_dly(ntodo) = 1
	}
	td_dfull = todo_daily_chk & (ndly >= 20) & (todo_dly(ntodo) = 0)
	todo_at(ntodo) = strf("%04d-%02d-%02d %02d:%02d", gettime(0), gettime(1), gettime(3), gettime(4), gettime(5)) : ntodo++
	gosub *save_todo
	bubble = "よし、持っとく！" : bubt = 80
	if td_dfull : bubble = "毎日のは20個までだ。今日の分だけ持っとく" : bubt = 120
	td_added = 1
	return

*todo_done
	if (tdi < 0) | (tdi >= ntodo) : return
	if todo_d(tdi) : return
	todo_d(tdi) = 1 : todo_day(tdi) = curday : todo_min(tdi) = -1
	; 追加してから終わるまでの時間（分）
	if todo_at(tdi) != "" {
		ta = todo_at(tdi) : gosub *todo_abs : tm0 = tm_abs
		ta = strf("%04d-%02d-%02d %02d:%02d", gettime(0), gettime(1), gettime(3), gettime(4), gettime(5)) : gosub *todo_abs
		if tm_abs >= tm0 : todo_min(tdi) = tm_abs - tm0
	}
	todos_today++
	gosub *save_todo
	toss_pending = 1
	bubble = "ひとつ片づいたな！" : bubt = 90
	return

*todo_open
	if todo_made = 0 {
		screen 10, UI(440), UI(400), 2, (wa(0) + wa(2)) / 2 - UI(220), (wa(1) + wa(3)) / 2 - UI(200)
		title "やることリスト"
		color 250, 250, 246 : boxf
		font "Meiryo UI", UI(14) : objmode 2
		color 40, 40, 48 : pos UI(16), UI(10) : mes "いちばん上のやることを、棒人間が持って歩きます"
		tsel = -1
		pos UI(16), UI(38) : objsize UI(408), UI(24) : listbox tsel, UI(176), "" : todo_lb = stat
		sdim todo_in, 256
		pos UI(16), UI(252) : input todo_in, UI(232), UI(30), 120 : todo_inp = stat
		todo_inp_h = objinfo(todo_inp, 2)
		; 「毎日」にチェックして追加すると、毎日のやることになる（日付が変わるたびに入る）
		todo_daily_chk = 0
		pos UI(256), UI(254) : objsize UI(64), UI(26) : chkbox "毎日", todo_daily_chk
		pos UI(324), UI(250) : objsize UI(100), UI(34) : button gosub "追加", *todo_add_btn
		objsize UI(100), UI(34)
		pos UI(16), UI(300) : button gosub "終わった！", *todo_done_btn
		pos UI(120), UI(300) : button gosub "いちばん上へ", *todo_up_btn
		pos UI(224), UI(300) : button gosub "消す", *todo_del_btn
		pos UI(328), UI(300) : button gosub "閉じる", *todo_close
		font "Meiryo UI", UI(12) : color 130, 130, 140 : pos UI(16), UI(352)
		mes "終わったら、次の日に削除するぞ"
		pos UI(16), UI(370) : mes "（35分）は、入れてから終わるまでにかかった時間だ"
		todo_made = 1
	}
	gsel 10
	gosub *todo_fill
	win_id = 10 : gosub *show_win
	return

; リストの中身を作り直す（まだのもの → 今日済んだもの）
*todo_fill
	dim todo_map, 40 : nmap = 0 : sdim tlist, 16384
	repeat ntodo
		if todo_d(cnt) = 0 {
			tlist += "・" + todo_s(cnt)
			if todo_dly(cnt) : tlist += "（毎日）"
			tlist += "\n" : todo_map(nmap) = cnt : nmap++
		}
	loop
	repeat ntodo
		if todo_d(cnt) & (todo_day(cnt) = curday) {
			tm = todo_min(cnt) : gosub *todo_took
			tlist += "✓ " + todo_s(cnt) + took_s + "\n" : todo_map(nmap) = cnt : nmap++
		}
	loop
	gsel 10
	objprm todo_lb, tlist
	gsel 1
	return

; 選んでいる行（LB_GETCURSEL）を、todo の番号にする
*todo_sel
	gsel 10
	sendmsg objinfo(todo_lb, 2), 0x188, 0, 0
	ts = stat : tdi = -1
	if (ts >= 0) & (ts < nmap) : tdi = todo_map(ts)
	return

*todo_add_btn
	gsel 10
	gosub *todo_add
	if td_added : objprm todo_inp, ""
	gosub *todo_fill
	return

*todo_done_btn
	gosub *todo_sel
	if tdi < 0 : gosub *todo_first : tdi = todo_top
	gosub *todo_done
	gosub *todo_fill
	return

*todo_up_btn
	gosub *todo_sel
	if tdi <= 0 : gsel 1 : return
	tk_s = todo_s(tdi) : tk_d = todo_d(tdi) : tk_day = todo_day(tdi) : tk_at = todo_at(tdi) : tk_min = todo_min(tdi) : tk_dly = todo_dly(tdi)
	gosub *todo_remove
	repeat ntodo
		ti = ntodo - cnt
		todo_s(ti) = todo_s(ti - 1) : todo_d(ti) = todo_d(ti - 1) : todo_day(ti) = todo_day(ti - 1) : todo_at(ti) = todo_at(ti - 1) : todo_min(ti) = todo_min(ti - 1) : todo_dly(ti) = todo_dly(ti - 1)
	loop
	todo_s(0) = tk_s : todo_d(0) = tk_d : todo_day(0) = tk_day : todo_at(0) = tk_at : todo_min(0) = tk_min : todo_dly(0) = tk_dly : ntodo++
	gosub *save_todo
	gosub *todo_fill
	return

*todo_del_btn
	gosub *todo_sel
	gosub *todo_del
	gosub *save_todo
	gosub *todo_fill
	return

; tdi 番を消す
*todo_del
	; 毎日のやることを消したら、毎日のほうからも外す（次の日から入らない）
	if (tdi >= 0) & (tdi < ntodo) {
		if todo_dly(tdi) {
			tdn_k = -1
			repeat ndly
				if dly_s(cnt) = todo_s(tdi) : tdn_k = cnt : break
			loop
			if tdn_k >= 0 {
				repeat ndly - tdn_k - 1, tdn_k
					dly_s(cnt) = dly_s(cnt + 1)
				loop
				ndly-- : gosub *save_daily
			}
		}
	}
	gosub *todo_remove
	return

*todo_close
	todo_inp_h = 0
	gsel 10, -1
	gsel 1
	return

; カーソルを乗せたときのやることの札をクリックしたとき
*todo_hover_click
	if td_undo >= ntodo : td_undo = -1
	if td_undo >= 0 {
		if todo_s(td_undo) != td_undo_s : td_undo = -1
	}
	if (td_undo >= 0) & (frame < td_undo_t) {
		; 済ませた直後なら、まだに戻す
		tdi = td_undo
		if todo_d(tdi) {
			todo_d(tdi) = 0 : todo_day(tdi) = "" : todo_min(tdi) = -1
			if todos_today > 0 : todos_today--
			toss_pending = 0
			if (state = ST_ACT) & (act = ACT_TOSS) : state = ST_IDLE : stimer = 0
			gosub *save_todo
			bubble = "おっと、まだだったか" : bubt = 70
		}
		td_undo = -1
	} else {
		gosub *todo_first
		if todo_top < 0 : return
		tdi = todo_top : gosub *todo_done
		td_undo = tdi : td_undo_t = frame + 60 * 8 : td_undo_s = todo_s(tdi)
	}
	gosub *todo_first
	if todo_made : gosub *todo_fill
	return

; 「2026-10-17 14:05」（ta）を、通しの分（tm_abs）にする
*todo_abs
	dy = int(strmid(ta, 0, 4)) : dm = int(strmid(ta, 5, 2)) : dd = int(strmid(ta, 8, 2))
	gosub *day_num
	tm_abs = dnum * 1440 + int(strmid(ta, 11, 2)) * 60 + int(strmid(ta, 14, 2))
	return

; かかった時間（tm 分）を「（35分）」のような文字（took_s）にする。わからなければ空
*todo_took
	took_s = ""
	if tm < 0 : return
	if tm < 60 : took_s = "（" + tm + "分）" : return
	if tm < 1440 : took_s = strf("（%d時間%d分）", tm / 60, tm \ 60) : return
	took_s = strf("（%d日%d時間）", tm / 1440, (tm / 60) \ 24)
	return

; 今日済んだものの数（td_n）と、かかった時間がわかるものの平均（td_avg。なければ -1）
*todo_today_stat
	td_n = 0 : td_sum = 0 : td_k = 0 : td_avg = -1
	repeat ntodo
		if todo_d(cnt) & (todo_day(cnt) = curday) {
			td_n++
			if todo_min(cnt) >= 0 : td_sum += todo_min(cnt) : td_k++
		}
	loop
	if td_k : td_avg = td_sum / td_k
	return
