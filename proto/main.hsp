#func GdipFillPie "GdipFillPie" int, int, float, float, float, float, float, float
#func GdipDrawImageRectI "GdipDrawImageRectI" int, int, int, int, int, int
#func GdipDrawImageRectRectI "GdipDrawImageRectRectI" int, int, int, int, int, int, int, int, int, int, int, int, int, int

#usecom IMMDeviceEnumerator "{A95664D2-9614-4F35-A746-DE8DB63617E6}" "{BCDE0395-E52F-467C-8E3D-C4579291692E}"
#comfunc MMDE_GetDefaultAudioEndpoint 4 int, int, var
#usecom IMMDevice "{D666063F-1587-4E43-81F1-B948E807363F}" "{BCDE0395-E52F-467C-8E3D-C4579291692E}"
#comfunc MMD_Activate 3 var, int, int, var
#usecom IAudioMeterInformation "{C02216F6-8C67-4B5B-9D00-D008E73E0064}" "{BCDE0395-E52F-467C-8E3D-C4579291692E}"
#comfunc AMI_GetPeakValue 3 var

#const GW_HWNDNEXT 2
#const GA_ROOT 2
#const GWL_EXSTYLE -20
#const WS_EX_TRANSPARENT 0x20
#const WS_EX_TOOLWINDOW 0x80
#const WS_EX_LAYERED 0x80000
#const WS_EX_NOACTIVATE 0x08000000
#const DWMWA_EXTENDED_FRAME_BOUNDS 9
#const DWMWA_CLOAKED 14
#const MAXPLAT 512

; キャラのウィンドウ。足元は FOOTY の高さ（座ったときに足を下へ垂らせるよう下に余白）
#const LW 220
#const LH 140
#const LF 116
#const GRAV 0.5
#const RAD 0.0174532925
#const INK 0xFF2E2E36

; 状態
#enum ST_IDLE = 0
#enum ST_WALK
#enum ST_FRONT
#enum ST_SLACK
#enum ST_SLEEP
#enum ST_POKED
#enum ST_ANGRY
#enum ST_REST
#enum ST_WAVE
#enum ST_CHEER
#enum ST_PAUSE
#enum ST_ACT
#enum ST_TYPE
#enum ST_SIGN
#enum ST_DIZZY
#enum ST_HAPPY
#enum ST_CALL
#enum ST_LAND
#enum ST_CLIMB
#enum ST_BEHIND
#enum ST_GROOVE
#enum ST_SCOLD
#enum ST_GOTO
#enum ST_PEEK
#enum ST_ALARM

; 小さな動き（ST_ACT のとき）
#enum ACT_TEA = 0
#enum ACT_STICK
#enum ACT_PUSHUP
#enum ACT_READ
#enum ACT_SWEEP
#enum ACT_DANCE
#enum ACT_WIPE
#enum ACT_FLAT
#enum ACT_KICKCAN
