; デスクトップのウィンドウを歩き回るポモドーロタイマー 試作
; 作業中は勝手に歩き回って色々し、休憩になると使っているウィンドウに来て座る
; 左クリック：つつく　ドラッグ：つまんで投げる　右クリック：メニュー
#include "hsp3utf.as"
; 小さな窓（設定・やること・時刻など）の座標と字の大きさを、画面の拡大率（uis）に合わせる
#define global ctype UI(%1) int(double(%1) * uis)
#include "hspinet.as"
; 実行ファイル名は題名が決まるまでの仮
