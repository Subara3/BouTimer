; ---- 関数（本体は上から流れて実行されないよう、ファイルの最後に置く） ----
; qjson（JSON）から数を1つ読む（キーのあとの数。null は 0）。読み終えた位置を jpos に残す
#defcfunc jnum int p_at, str p_key
	jk = instr(qjson, p_at, "\"" + p_key + "\":")
	if jk < 0 : jpos = p_at : return 0.0
	jq = p_at + jk + strlen(p_key) + 3
	repeat 8
		if peek(qjson, jq) != ' ' : break
		jq++
	loop
	jpos = jq
	if peek(qjson, jq) = 'n' : return 0.0
	return double(strmid(qjson, jq, 24))
