#func GdipSetStringFormatLineAlign "GdipSetStringFormatLineAlign" int, int
#func GdipDrawString "GdipDrawString" int, wstr, int, int, var, int, int
#func GdipFillPolygonI "GdipFillPolygonI" int, int, var, int, int
#func GdipDrawPolygonI "GdipDrawPolygonI" int, int, var, int
#func GdipSaveImageToFile "GdipSaveImageToFile" int, wstr, var, int
