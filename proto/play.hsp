; 作業のおとも、棒人間：あそびの動き（縄跳び・ジャグリング・しゃぼん玉・紙飛行機・おにぎり・ヨーヨー・フラフープ・けん玉・ダンベル・自撮り・ブーメラン）
; main.hsp から #include で読み込む（ラベルだけのファイル。上から流れては実行されない）
; 体のポーズは *play_pose、道具や飛んでいくものは *draw_play で、体と同じ座標（足もとが 0）に描く

; 始めるとき（長さと最初のひとこと）
*play_start
	; 絵日記に書けるように数える（あそびの動きと出来事は同じ並び）
	evc(EV_ROPE + act - ACT_ROPE)++
	if act = ACT_ROPE : sdur = 330 : bubble = "縄跳びするか" : bubt = 60
	if act = ACT_JUGGLE : sdur = 330 : bubble = "ジャグリング！" : bubt = 60
	if act = ACT_BUBBLE : sdur = 380 : bubble = "しゃぼん玉だ" : bubt = 60
	if act = ACT_PLANE : sdur = 300 : bubble = "紙飛行機、折るか" : bubt = 60
	if act = ACT_ONIGIRI : sdur = 320 : bubble = "腹へったな" : bubt = 60 : oni_ume = rnd(3)
	if act = ACT_YOYO : sdur = 320 : bubble = "ヨーヨー" : bubt = 50
	if act = ACT_HOOP : sdur = 300 : bubble = "フラフープ！" : bubt = 50
	if act = ACT_KENDAMA : sdur = 300
	if act = ACT_DUMBBELL : sdur = 280
	if act = ACT_SELFIE : sdur = 250
	if act = ACT_BOOMERANG : sdur = 290
	return

; とちゅうのひとこと
*play_brain
	if act = ACT_ROPE {
		if stimer = 150 : bubble = "ほっ、ほっ" : bubt = 60
	}
	if act = ACT_JUGGLE {
		if stimer = 260 : bubble = "おっと" : bubt = 50
	}
	if act = ACT_BUBBLE {
		if stimer = 40 : bubble = "ふーっ" : bubt = 50
		if stimer = 230 : bubble = "きれいだな" : bubt = 60
	}
	if act = ACT_PLANE {
		if stimer = 92 : bubble = "それっ" : bubt = 40
		if stimer = 200 : bubble = "よく飛んだ！" : bubt = 60
	}
	if act = ACT_ONIGIRI {
		if stimer = 150 {
			if oni_ume = 0 : bubble = "梅干しだ、すっぱ！" : bubt = 70
			if oni_ume = 1 : bubble = "鮭だ、うまい" : bubt = 60
			if oni_ume = 2 : bubble = "ツナマヨだ" : bubt = 60
		}
	}
	if act = ACT_YOYO {
		if stimer = 170 : bubble = "犬の散歩！" : bubt = 70
	}
	if act = ACT_HOOP {
		if stimer = 150 : bubble = "まだまだ回るぞ" : bubt = 60
		if stimer = 268 : bubble = "あっ、落ちた" : bubt = 50
	}
	if act = ACT_KENDAMA {
		; 2回しくじって、3回目でのせる
		if stimer = 64 : bubble = "あっ" : bubt = 40
		if stimer = 164 : bubble = "おしい" : bubt = 40
		if stimer = 262 : bubble = "のった！" : bubt = 50
	}
	if act = ACT_DUMBBELL {
		if stimer = 60 : bubble = "ふんっ" : bubt = 40
		if stimer = 190 : bubble = "あと3回…" : bubt = 50
	}
	if act = ACT_SELFIE {
		if stimer = 70 : bubble = "はい、チーズ" : bubt = 50
		if stimer = 170 : bubble = "よく撮れた" : bubt = 50
	}
	if act = ACT_BOOMERANG {
		if stimer = 80 : bubble = "戻ってこーい" : bubt = 60
		if stimer = 206 : bubble = "キャッチ！" : bubt = 50
	}
	return

; 終わったときのひとこと
*play_end
	if act = ACT_ROPE : bubble = "30回は跳んだな" : bubt = 60
	if act = ACT_JUGGLE : bubble = "次は落とさないぞ" : bubt = 60
	if act = ACT_ONIGIRI : bubble = "ごちそうさん" : bubt = 60
	if act = ACT_YOYO : bubble = "よし、戻ってきた" : bubt = 50
	if act = ACT_DUMBBELL : bubble = "腕がぱんぱんだ" : bubt = 60
	return

*play_pose
	if act = ACT_ROPE {
		; 縄が足の下を通るときに跳ぶ
		view = 1 : mouth = 3
		ra = double(stimer) * 0.16
		rhop = maxf(0.0, cos(ra))
		hipy = -24.0 - rhop * rhop * 15.0
		aa1(0) = 45.0 + sin(ra) * 8.0 : aa2(0) = 70.0 : aa1(1) = 45.0 + sin(ra) * 8.0 : aa2(1) = 70.0
		la1(0) = -4.0 - rhop * 6.0 : la2(0) = 10.0 * rhop : la1(1) = 4.0 + rhop * 6.0 : la2(1) = -10.0 * rhop
		return
	}
	if act = ACT_JUGGLE {
		view = 1 : mouth = 2 : lookdown = 0
		ja = double(stimer) * 0.22
		aa1(0) = 70.0 + sin(ja) * 12.0 : aa2(0) = 120.0
		aa1(1) = 70.0 - sin(ja) * 12.0 : aa2(1) = 120.0
		if (stimer >= 260) & (stimer < 300) : eyes = 6 : mouth = 4
		return
	}
	if act = ACT_BUBBLE {
		; 片手でストローを口に当てて吹く
		mouth = 0 : lean = -3.0
		aa1(0) = 100.0 : aa2(0) = 175.0
		aa1(1) = 20.0 : aa2(1) = 40.0
		if (stimer \ 80) < 30 : eyes = 1
		return
	}
	if act = ACT_PLANE {
		if stimer < 80 {
			; 手もとで折る
			lookdown = 1 : mouth = 2
			fo = sin(double(stimer) * 0.6) * 6.0
			aa1(0) = 55.0 + fo : aa2(0) = 110.0 : aa1(1) = 50.0 - fo : aa2(1) = 105.0
			return
		}
		if stimer < 92 {
			; ふりかぶる
			lean = -6.0 : mouth = 4
			aa1(0) = 160.0 : aa2(0) = 200.0 : aa1(1) = 30.0 : aa2(1) = 50.0
			return
		}
		if stimer < 110 {
			lean = 6.0 : mouth = 3
			aa1(0) = 100.0 : aa2(0) = 95.0 : aa1(1) = -20.0 : aa2(1) = -10.0
			return
		}
		; 見送る（片手をおでこにかざす）
		mouth = 3 : lean = -4.0
		aa1(0) = 150.0 : aa2(0) = 70.0
		return
	}
	if act = ACT_ONIGIRI {
		gosub *sit_floor_pose
		k = stimer \ 70
		if (k > 30) & (k < 50) {
			; かじる
			aa1(0) = 60.0 : aa2(0) = 190.0 : mouth = 3 : eyes = 1
		} else {
			aa1(0) = 50.0 : aa2(0) = 140.0 : mouth = 1
		}
		if (oni_ume = 0) & (stimer > 150) & (stimer < 200) : eyes = 5 : mouth = 4
		return
	}
	if act = ACT_YOYO {
		mouth = 1
		yo = double(stimer) * 0.12
		aa1(0) = 40.0 : aa2(0) = 70.0 + sin(yo) * 15.0
		aa1(1) = 10.0 : aa2(1) = 25.0
		if stimer >= 170 : aa2(0) = 80.0 : lookdown = 1
		return
	}
	if act = ACT_HOOP {
		; 両手を上げて腰を回す。終わりぎわにフープが足もとへ落ちる
		view = 1 : mouth = 3
		la1(0) = -8.0 : la2(0) = -8.0 : la1(1) = 8.0 : la2(1) = 8.0
		aa1(0) = 125.0 : aa2(0) = 150.0 : aa1(1) = 125.0 : aa2(1) = 150.0
		if stimer < 260 {
			hipx = sin(double(stimer) * 0.3) * 2.5 : lean = sin(double(stimer) * 0.3) * 3.0
		} else {
			eyes = 6 : mouth = 4
		}
		return
	}
	if act = ACT_KENDAMA {
		; 胸の前でけんを持ち、玉を振り上げる
		mouth = 2
		aa1(0) = 30.0 : aa2(0) = 120.0 : aa1(1) = 15.0 : aa2(1) = 30.0
		k = stimer \ 100
		if (k >= 36) & (k < 46) & (stimer < 262) : aa2(0) = 145.0
		if (stimer / 100 < 2) & (k >= 62) & (k < 82) : eyes = 6 : mouth = 4
		if stimer >= 262 : mouth = 3
		return
	}
	if act = ACT_DUMBBELL {
		; 正面を向いて両手でカール。後半は疲れて遅くなる
		view = 1 : mouth = 1
		la1(0) = -7.0 : la2(0) = -7.0 : la1(1) = 7.0 : la2(1) = 7.0
		if stimer < 180 {
			ph = double(stimer) * 0.11
		} else {
			ph = 19.8 + double(stimer - 180) * 0.07
		}
		c = (1.0 - cos(ph)) / 2.0
		aa1(0) = 12.0 : aa1(1) = 12.0 : aa2(0) = 15.0 + c * 150.0 : aa2(1) = 15.0 + c * 150.0
		if c > 0.7 : eyes = 4 : mouth = 4
		return
	}
	if act = ACT_SELFIE {
		view = 1 : mouth = 3
		if stimer < 160 {
			; 片手で電話を高く構え、もう片手でピース
			aa1(1) = 120.0 : aa2(1) = 135.0
			aa1(0) = 40.0 : aa2(0) = 160.0
			if (stimer >= 76) & (stimer < 84) : eyes = 1
		} else {
			; 撮れたのを見る
			aa1(1) = 50.0 : aa2(1) = 120.0 : lookdown = 1
		}
		return
	}
	if act = ACT_BOOMERANG {
		if stimer < 30 {
			lean = -6.0 : mouth = 4
			aa1(0) = 160.0 : aa2(0) = 200.0 : aa1(1) = 30.0 : aa2(1) = 50.0
			return
		}
		if stimer < 42 {
			lean = 6.0 : mouth = 3
			aa1(0) = 100.0 : aa2(0) = 95.0 : aa1(1) = -20.0 : aa2(1) = -10.0
			return
		}
		mouth = 3 : lean = -2.0
		if stimer >= 185 : aa1(0) = 95.0 : aa2(0) = 100.0 : lean = 0.0
		if stimer >= 235 : aa1(0) = 125.0 : aa2(0) = 150.0
		return
	}
	return

; 道具と、飛んでいくもの
*draw_play
	if act = ACT_ROPE {
		; 縄：左手から右手へ、回っている位置に合わせてたわませる
		ra = double(stimer) * 0.16
		rmx = (lhx + handx) / 2.0 : rmy = (lhy + handy) / 2.0 + cos(ra) * 46.0 - 4.0
		GdipSetPenColor pen, 0xFFB0603A : GdipSetPenWidth pen, 1.6
		px1 = lhx : py1 = lhy
		repeat 12
			tq = double(cnt + 1) / 12.0
			px2 = (1.0 - tq) * (1.0 - tq) * lhx + 2.0 * tq * (1.0 - tq) * rmx + tq * tq * handx
			py2 = (1.0 - tq) * (1.0 - tq) * lhy + 2.0 * tq * (1.0 - tq) * (rmy * 2.0 - (lhy + handy) / 2.0) + tq * tq * handy
			GdipDrawLine gfx, pen, px1, py1, px2, py2
			px1 = px2 : py1 = py2
		loop
		gosub *pen_back
		return
	}
	if act = ACT_JUGGLE {
		; 3つの玉が手の上で回る（最後のほうで1つ落とす）
		ja = double(stimer) * 0.11
		repeat 3
			jp = ja + double(cnt) * 2.094
			jx = cos(jp) * 14.0 : jy = -66.0 - absf(sin(jp)) * 24.0
			if (cnt = 2) & (stimer >= 260) {
				jt = double(limit(stimer - 260, 0, 40)) / 40.0
				jx = 14.0 + jt * 10.0 : jy = -66.0 + jt * 64.0
			}
			if cnt = 0 : GdipSetSolidFillColor brush, 0xFFE05050
			if cnt = 1 : GdipSetSolidFillColor brush, 0xFF4A80E0
			if cnt = 2 : GdipSetSolidFillColor brush, 0xFFF0C030
			GdipFillEllipse gfx, brush, jx - 4.0, jy - 4.0, 8.0, 8.0
		loop
		return
	}
	if act = ACT_BUBBLE {
		; 口もとから、しゃぼん玉がゆらゆら上がる
		GdipSetPenColor pen, 0xF06A9ED8 : GdipSetPenWidth pen, 1.4
		repeat 7
			age = stimer - 30 - cnt * 45
			if (age <= 0) | (age > 220) : continue
			br = 4.5 + double(cnt \ 3) * 2.0
			bx2 = headx + 14.0 + double(age) * 0.32 : by2 = heady + 2.0 - double(age) * 0.36 + sin(double(age) * 0.1 + double(cnt)) * 3.0
			if by2 < -112.0 : continue
			GdipDrawEllipse gfx, pen, bx2 - br, by2 - br, br * 2.0, br * 2.0
			GdipSetSolidFillColor brush, 0xA0FFFFFF
			GdipFillEllipse gfx, brush, bx2 - br * 0.5, by2 - br * 0.6, br * 0.6, br * 0.5
		loop
		gosub *pen_back
		return
	}
	if act = ACT_PLANE {
		if stimer < 92 {
			px = handx : py = handy - 3.0 : psz2 = 5.0 + double(limit(stimer, 0, 80)) / 16.0
		} else {
			if stimer < 100 : return
			pt = double(stimer - 100)
			px = 12.0 + pt * 0.55 : py = -62.0 - sin(pt * 0.035) * 22.0 + pt * 0.12 : psz2 = 10.0
			if px > 104.0 : return
		}
		poly(0) = int(px - psz2) : poly(1) = int(py - psz2 * 0.35)
		poly(2) = int(px + psz2) : poly(3) = int(py)
		poly(4) = int(px - psz2) : poly(5) = int(py + psz2 * 0.45)
		GdipSetSolidFillColor brush, 0xFFFFFFFF
		GdipFillPolygonI gfx, brush, poly, 3, 0
		GdipSetPenWidth pen, 1.2
		GdipDrawLine gfx, pen, px - psz2, py - psz2 * 0.35, px + psz2, py
		GdipDrawLine gfx, pen, px + psz2, py, px - psz2, py + psz2 * 0.45
		GdipDrawLine gfx, pen, px - psz2, py + psz2 * 0.05, px + psz2, py
		gosub *pen_back
		return
	}
	if act = ACT_ONIGIRI {
		; かじるたびに小さくなる三角のおにぎり（のりつき）
		os = 9.0 - double(limit(stimer / 70, 0, 4)) * 1.6
		ox = handx + 2.0 : oy = handy - 3.0
		poly(0) = int(ox) : poly(1) = int(oy - os)
		poly(2) = int(ox + os) : poly(3) = int(oy + os * 0.7)
		poly(4) = int(ox - os) : poly(5) = int(oy + os * 0.7)
		GdipSetSolidFillColor brush, 0xFFFFFFFF
		GdipFillPolygonI gfx, brush, poly, 3, 0
		GdipSetPenWidth pen, 1.2
		GdipDrawLine gfx, pen, ox, oy - os, ox + os, oy + os * 0.7
		GdipDrawLine gfx, pen, ox + os, oy + os * 0.7, ox - os, oy + os * 0.7
		GdipDrawLine gfx, pen, ox - os, oy + os * 0.7, ox, oy - os
		GdipSetSolidFillColor brush, 0xFF24302A
		GdipFillRectangle gfx, brush, ox - os * 0.35, oy + os * 0.05, os * 0.7, os * 0.62
		gosub *pen_back
		return
	}
	if act = ACT_YOYO {
		GdipSetPenColor pen, 0xFF606070 : GdipSetPenWidth pen, 1.0
		if stimer < 170 {
			; 上下にのびちぢみ
			yl = (1.0 - cos(double(stimer) * 0.12)) * 20.0 + 4.0
			yx = handx : yy = handy + yl
		} else {
			; 犬の散歩：床を転がっていく
			yt = double(limit(stimer - 170, 0, 120))
			yx = handx + 6.0 + yt * 0.3 : yy = -4.0
			if stimer > 290 : yx = handx : yy = handy + 6.0
		}
		GdipDrawLine gfx, pen, handx, handy, yx, yy
		GdipSetSolidFillColor brush, 0xFFE05050
		GdipFillEllipse gfx, brush, yx - 4.0, yy - 4.0, 8.0, 8.0
		gosub *pen_back
		return
	}
	if act = ACT_HOOP {
		; 腰のまわりを回る輪。奥の半分はうすく、手前の半分は濃く
		if stimer < 260 {
			ht = double(stimer) * 0.3
			hcx = hipx + cos(ht) * 5.0 : hcy = -28.0
		} else {
			hcx = 0.0 : hcy = -28.0 + limitf(double(stimer - 260) / 8.0, 0.0, 1.0) * 26.0
		}
		GdipSetPenWidth pen, 2.2
		GdipSetPenColor pen, 0x90E07030
		GdipDrawArc gfx, pen, hcx - 17.0, hcy - 3.5, 34.0, 7.0, 180.0, 180.0
		GdipSetPenColor pen, 0xFFE07030
		GdipDrawArc gfx, pen, hcx - 17.0, hcy - 3.5, 34.0, 7.0, 0.0, 180.0
		gosub *pen_back
		return
	}
	if act = ACT_KENDAMA {
		; 玉は、ぶら下がる → 振り上げる → 皿にのる（3回目）／こぼれる（1・2回目）
		k = stimer \ 100 : ktr = stimer / 100
		hx = handx : hy = handy
		if k < 40 {
			ka = sin(double(k) * 0.22) * 0.5
			kbx = hx + sin(ka) * 15.0 : kby = hy - 2.0 + cos(ka) * 15.0
		} else {
			if k < 62 {
				kq = double(k - 40) / 22.0 : kex = 0.0
				if ktr < 2 : kex = 6.0
				kbx = hx + sin(kq * 3.1416) * 7.0 + kex * kq : kby = hy + 13.0 - kq * 28.0 - sin(kq * 3.1416) * 12.0
			} else {
				if ktr >= 2 {
					kbx = hx : kby = hy - 15.5
				} else {
					kq = limitf(double(k - 62) / 10.0, 0.0, 1.0)
					kbx = hx + 6.0 - 6.0 * kq + sin(double(k) * 0.4) * 3.0 * kq : kby = hy - 15.0 + kq * 28.0
				}
			}
		}
		GdipSetPenColor pen, 0xFF707080 : GdipSetPenWidth pen, 0.8
		GdipDrawLine gfx, pen, hx, hy - 2.0, kbx, kby
		GdipSetPenColor pen, 0xFFB07840 : GdipSetPenWidth pen, 2.2
		GdipDrawLine gfx, pen, hx, hy + 5.0, hx, hy - 11.0
		GdipSetSolidFillColor brush, 0xFFB07840
		GdipFillEllipse gfx, brush, hx - 4.5, hy - 13.0, 9.0, 3.5
		GdipSetSolidFillColor brush, 0xFFE05050
		GdipFillEllipse gfx, brush, kbx - 3.5, kby - 3.5, 7.0, 7.0
		gosub *pen_back
		return
	}
	if act = ACT_DUMBBELL {
		; 両手にダンベル（横向きの棒と、両はしのおもり）
		GdipSetPenColor pen, 0xFF606070 : GdipSetPenWidth pen, 2.0
		GdipSetSolidFillColor brush, 0xFF40404C
		dbx = lhx : dby = lhy
		repeat 2
			GdipDrawLine gfx, pen, dbx - 5.0, dby, dbx + 5.0, dby
			GdipFillRectangle gfx, brush, dbx - 7.0, dby - 3.5, 3.0, 7.0
			GdipFillRectangle gfx, brush, dbx + 4.0, dby - 3.5, 3.0, 7.0
			dbx = handx : dby = handy
		loop
		gosub *pen_back
		return
	}
	if act = ACT_SELFIE {
		; 電話（画面つき）と、ピースの指。撮った瞬間に光る
		GdipSetSolidFillColor brush, 0xFF30303A
		GdipFillRectangle gfx, brush, handx - 3.0, handy - 5.0, 6.0, 9.0
		GdipSetSolidFillColor brush, 0xFF8EC8F0
		GdipFillRectangle gfx, brush, handx - 2.0, handy - 4.0, 4.0, 6.5
		if stimer < 160 {
			GdipSetPenWidth pen, 1.6
			GdipDrawLine gfx, pen, lhx, lhy, lhx - 2.5, lhy - 6.0
			GdipDrawLine gfx, pen, lhx, lhy, lhx + 1.5, lhy - 6.5
		}
		if (stimer >= 76) & (stimer < 92) {
			fa = (92 - stimer) * 14
			GdipSetSolidFillColor brush, (fa << 24) | (fa << 16) | (fa << 8) | fa
			GdipFillEllipse gfx, brush, handx - 14.0, handy - 14.0, 28.0, 28.0
		}
		gosub *pen_back
		return
	}
	if act = ACT_BOOMERANG {
		; くの字の板。投げたら前へ大きく回って手もとへ戻る
		if (stimer < 36) | (stimer >= 205) {
			bmx = handx : bmy = handy : bma = 30.0
		} else {
			bt = double(stimer - 36) / 169.0
			bmx = 19.0 + sin(bt * 3.1416) * 76.0 : bmy = -40.0 - sin(bt * 3.1416) * 24.0 - sin(bt * 6.2832) * 12.0
			bma = double(stimer) * 28.0
		}
		GdipSetPenColor pen, 0xFF9A6A3A : GdipSetPenWidth pen, 2.6
		GdipDrawLine gfx, pen, bmx, bmy, bmx + cos(bma * RAD) * 7.0, bmy + sin(bma * RAD) * 7.0
		GdipDrawLine gfx, pen, bmx, bmy, bmx + cos((bma + 110.0) * RAD) * 7.0, bmy + sin((bma + 110.0) * RAD) * 7.0
		gosub *pen_back
		return
	}
	return
